# syntax=docker/dockerfile:1
# 映像檔 = debian:12-slim + 從 GitHub Releases 下載的 .deb,不在此編譯。
# VERSION/PKG_RELEASE 由 Makefile 從 config/openresty/build.env 帶入。
# rootless 變體:整個行程以 openresty 使用者執行,監聽 8080;
# PID/暫存檔移到 /tmp,日誌直接寫 stdout/stderr(見 nginx-rootless.conf)。

ARG REPO=linzeyan/nginx

# 獨立的下載階段:.deb 只存在於這一層,不會留在最終映像檔裡。
FROM debian:12-slim AS fetch
ARG REPO
ARG VERSION
ARG PKG_RELEASE
ARG TARGETARCH
ADD https://github.com/${REPO}/releases/download/openresty-${VERSION}-${PKG_RELEASE}/openresty_${VERSION}-${PKG_RELEASE}_${TARGETARCH}.deb /tmp/openresty.deb

FROM debian:12-slim
RUN --mount=from=fetch,source=/tmp/openresty.deb,target=/tmp/openresty.deb \
    apt-get update \
    && apt-get install -y --no-install-recommends /tmp/openresty.deb \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/local/openresty/bin:$PATH
# openresty 使用者由套件的 postinstall 建立,這裡直接沿用。
COPY nginx-rootless.conf /usr/local/openresty/nginx/conf/nginx.conf
# 非特權模式:監聽埠移到 1024 以上;conf.d 保持可寫,
# 方便衍生映像在啟動時動態產生 vhost 設定。
RUN sed -i 's/listen  *80;/listen 8080;/' /usr/local/openresty/nginx/conf/conf.d/default.conf \
    && chown -R openresty:openresty /usr/local/openresty/nginx/conf /usr/local/openresty/nginx/logs
EXPOSE 8080
STOPSIGNAL SIGQUIT
USER openresty
CMD ["openresty", "-g", "daemon off;"]
