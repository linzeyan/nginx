# syntax=docker/dockerfile:1
# 映像檔 = debian:12-slim + 從 GitHub Releases 下載的 .deb,不在此編譯。
# VERSION/PKG_RELEASE 由 Makefile 從 config/nginx/build.env 帶入。
# root 變體:master 以 root 執行,監聽 80。

ARG REPO=linzeyan/nginx

# 獨立的下載階段:.deb 只存在於這一層,不會留在最終映像檔裡。
FROM debian:12-slim AS fetch
ARG REPO
ARG VERSION
ARG PKG_RELEASE
ARG TARGETARCH
ADD https://github.com/${REPO}/releases/download/nginx-${VERSION}-${PKG_RELEASE}/nginx_${VERSION}-${PKG_RELEASE}_${TARGETARCH}.deb /tmp/nginx.deb

FROM debian:12-slim
RUN --mount=from=fetch,source=/tmp/nginx.deb,target=/tmp/nginx.deb \
    apt-get update \
    && apt-get install -y --no-install-recommends /tmp/nginx.deb \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log
EXPOSE 80
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
