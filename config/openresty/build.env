# OpenResty 版本 pin。
# VERSION 與 PKG_RELEASE 會在上游釋出新版時由 check-versions workflow
# 自動改寫。同一 VERSION 要重發(例如改了模組或 configure 參數)時,
# 跑 make bump-release-openresty。
VERSION=1.27.1.2
PKG_RELEASE=1

# OpenSSL 停留在 3.0 線:OpenResty 官方 openresty-openssl3 套件
# 追蹤與測試的就是這條線。
OPENSSL_VERSION=3.0.21
PCRE2_VERSION=10.47
ZLIB_VERSION=1.3.2

# geoip2 模組用;一併靜態連結,避免套件依賴 EPEL 的 libmaxminddb。
LIBMAXMINDDB_VERSION=1.13.3
