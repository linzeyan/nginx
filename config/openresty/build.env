# OpenResty 版本 pin。
# VERSION 與 PKG_RELEASE 會在上游釋出新版時由 check-versions workflow
# 自動改寫。同一 VERSION 要重發(例如改了模組或 configure 參數)時,
# 跑 make bump-release-openresty。
VERSION=1.31.8.1
PKG_RELEASE=20261027

# 共用的 build script、nfpm 設定、packaging 與 docker 資產都以 FAMILY
# 定位;它同時是 deb/rpm 的套件名。
FAMILY=openresty

# 跟著 OpenResty 官方 openresty-openssl3 套件走 —— 它現在 pin 的就是
# 3.5.7(見 openresty-packaging 的 rpm/SPECS/openresty-openssl3.spec),
# 上游 patches/ 也已經備好 3.5 線的 sess_set_get_cb_yield patch。
# 3.5 是 OpenSSL 的 LTS 線;原本停留的 3.0 線在 2026-09-07 就結束支援。
OPENSSL_VERSION=3.5.7
PCRE2_VERSION=10.47
ZLIB_VERSION=1.3.2

# geoip2 模組用;一併靜態連結,避免套件依賴 EPEL 的 libmaxminddb。
LIBMAXMINDDB_VERSION=1.13.3
