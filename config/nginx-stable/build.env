# nginx stable 線(minor 為偶數)的版本 pin。
# VERSION 與 PKG_RELEASE 會在上游釋出新 stable 版時由 check-versions
# workflow 自動改寫。同一 VERSION 要重發(例如改了模組或 configure 參數)
# 時,跑 make bump-release-nginx-stable。
VERSION=1.30.5
PKG_RELEASE=20260916

# 共用的 build script、nfpm 設定、packaging 與 docker 資產都以 FAMILY
# 定位;它同時是 deb/rpm 的套件名 —— stable 與 mainline 出的都是套件
# nginx,兩者可直接互相升級(與 nginx.org 官方 repo 的做法一致)。
FAMILY=nginx

# 以下依賴會靜態連結進 binary,改版後同樣需要 bump PKG_RELEASE
# 才會以新的套件版次發佈。
OPENSSL_VERSION=3.5.7
PCRE2_VERSION=10.47
ZLIB_VERSION=1.3.2

# geoip2 模組用;一併靜態連結,避免套件依賴 EPEL 的 libmaxminddb。
LIBMAXMINDDB_VERSION=1.13.3
